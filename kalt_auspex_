/* ── SCAN MODE: gradual appearance ──
   Each mark gets a "revealTime" — the engine time at which it becomes visible.
   In scan mode we spread them over ~12 seconds.
   In instant mode all revealTimes = 0.
*/
var scanMode = true;
var scanInterval = null;
var revealedCount = 0;       // how many are currently revealed in scan mode
var markRevealAt = [];       // [index] = engine-time when mark appears
var SCAN_DURATION = 14.0;    // seconds to reveal all marks
var scanStartTime = 0;

function initReveal(instant){
  markRevealAt = [];
  if(instant){
    MARKS.forEach(function(){ markRevealAt.push(0); });
    revealedCount = MARKS.length;
  } else {
    /* spread evenly, with tiny random jitter so they don't pop all at once */
    MARKS.forEach(function(m, i){
      var base = (i / MARKS.length) * SCAN_DURATION;
      var jitter = (Math.random() - 0.5) * 0.5;
      markRevealAt.push(scanStartTime + base + jitter);
    });
    revealedCount = 0;
  }
}

function isRevealed(idx){
  if(!scanMode) return true;
  return time >= markRevealAt[idx];
}

function countRevealed(){
  if(!scanMode) return MARKS.length;
  var n=0;
  MARKS.forEach(function(m,i){ if(isRevealed(i)) n++; });
  return n;
}

/* alpha for a mark: fades in over 0.4s after reveal */
function revealAlpha(idx){
  if(!scanMode) return 1.0;
  if(!isRevealed(idx)) return 0.0;
  var elapsed = time - markRevealAt[idx];
  return Math.min(1.0, elapsed / 0.4);
}

