  var zoom=slv('sl-zoom'),tilt=slv('sl-tilt');
  var cy=Math.cos(rotY),sy=Math.sin(rotY);
  var rx=wx*cy-wz*sy,rz=wx*sy+wz*cy,ry=wy;
  var ang=tilt*1.25;
  var ca=Math.cos(ang),sa=Math.sin(ang);
  var ry2=ry*ca+rz*sa, rz2=-ry*sa+rz*ca;
  rz2+=2.6/zoom;
  if(rz2<0.04) return null;
  var f=1.3/zoom;
  return{sx:CX+(rx*f/rz2)*W, sy:CY-(ry2*f/rz2)*W, depth:rz2, sc:f/rz2};
}

function initMap(){
  cv=document.getElementById('cv');ctx=cv.getContext('2d');
  resize();window.addEventListener('resize',resize);

  /* initialise reveals: scan mode ON by default */
  scanStartTime = time; initReveal(false); document.getElementById('btn-scan').classList.add('active');

  cv.addEventListener('mousedown',function(e){
    var lr=document.getElementById('lp').getBoundingClientRect();
    var rr=document.getElementById('rp').getBoundingClientRect();
    if(e.clientX>=lr.left&&e.clientX<=lr.right)return;
    if(e.clientX>=rr.left&&e.clientX<=rr.right)return;
    dragging=true;lastMX=e.clientX;autoRot=false;
  });
  window.addEventListener('mouseup',function(){dragging=false;});
  cv.addEventListener('mousemove',onMove);
  cv.addEventListener('mouseleave',function(){hideTip();});
  cv.addEventListener('wheel',function(e){
    var cur=slv('sl-zoom');
    var delta=e.deltaY*(cur<0.3?0.0002:cur<1.0?0.0006:0.001);
    var z=Math.max(0.05,Math.min(4.0,cur-delta));
    setSl('sl-zoom','sv-zoom',z.toFixed(2));
  },{passive:true});

  stars=[];
  for(var i=0;i<900;i++){
    stars.push({nx:Math.random(),ny:Math.random(),
      r:Math.random()*1.1+0.15,b:Math.random()*0.45+0.08,tw:Math.random()*Math.PI*2});
  }
  requestAnimationFrame(loop);
}

function resize(){
  cv.width=window.innerWidth;cv.height=window.innerHeight;
  W=cv.width;H=cv.height;CX=W/2;CY=H/2;
}

function loop(){
  time+=0.016;
  if(autoRot) rotY+=slv('sl-rot')*0.0018;
  draw();requestAnimationFrame(loop);
}

function draw(){
  ctx.fillStyle='#000000';ctx.fillRect(0,0,W,H);

  var t2=time*0.25;
  stars.forEach(function(s){
    var tw=0.55+0.45*Math.sin(t2+s.tw);
    ctx.beginPath();ctx.arc(s.nx*W,s.ny*H,s.r,0,Math.PI*2);
    ctx.fillStyle='rgba(255,200,140,'+(s.b*tw*0.65)+')';ctx.fill();
  });

  if(showGrid) drawGrid();
  drawAxes();
  if(showLinks) drawLinks();
  drawPlanet();
  drawChains();

  /* project + depth-sort */
  var items=[];
  MARKS.forEach(function(m,i){
    var alpha=revealAlpha(i);
    if(alpha<=0) return;
    var n=normPt(m),p=proj(n.x,n.y,n.z);
    if(p) items.push({m:m,p:p,idx:i,ralpha:alpha});
  });
  items.sort(function(a,b){return b.p.depth-a.p.depth;});

  var vc=0;
  items.forEach(function(it){
    if(hiddenCats[it.m.category])return;
    vc++;
    drawMark(it.m,it.p,it.ralpha);
  });

  /* update HUD counters */
  var tot=countRevealed();
  document.getElementById('vc').textContent=vc;
  document.getElementById('vc2').textContent=vc;
  document.getElementById('hud-total').textContent=tot;
  document.getElementById('sb-total').textContent=tot;

  /* scan mode: draw scanning indicator */
  if(scanMode){
    var frac=Math.min(1.0,(time-scanStartTime)/SCAN_DURATION);
    var barW=(W-320-240)*frac;
    ctx.save();
    ctx.fillStyle='rgba(192,57,43,0.25)';
    ctx.fillRect(305,H-6,barW,4);
    ctx.strokeStyle='rgba(192,57,43,0.6)';ctx.lineWidth=1;
    ctx.strokeRect(305,H-6,W-320-240,4);
    /* scanning sweep line */
    var sweepX=305+(W-320-240)*frac;
    if(frac<1.0){
      var sg=ctx.createLinearGradient(sweepX-40,0,sweepX+5,0);
      sg.addColorStop(0,'rgba(255,80,0,0)');
      sg.addColorStop(1,'rgba(255,80,0,0.7)');
      ctx.fillStyle=sg;
      ctx.fillRect(sweepX-40,64,45,H-70);
    }
    ctx.font="10px 'Share Tech Mono',monospace";
    ctx.fillStyle='rgba(200,80,0,0.8)';
    ctx.textAlign='left';
    ctx.fillText('SCANNING :: '+tot+' / 132',310,H-10);
    ctx.restore();
  }
}


/* ── NARRATIVE LINKS — dashed arrows between connected marks ── */
function drawLinks(){
  /* build a lookup: id -> projected position */
  var posMap={};
  MARKS.forEach(function(m,i){
    var ra=revealAlpha(i);
    if(ra<=0) return;
    var n=normPt(m), p=proj(n.x,n.y,n.z);
    if(p) posMap[m.id]={sx:p.sx,sy:p.sy,sc:p.sc,depth:p.depth,alpha:ra};
  });

  ctx.save();
  LINKS.forEach(function(lk){
    var a=posMap[lk.from], b=posMap[lk.to];
    if(!a||!b) return;

    /* fade by average depth + reveal alpha */
    var alpha=Math.min(a.alpha,b.alpha)*Math.max(0.12,Math.min(0.55,(a.sc+b.sc)*3.5));
    if(alpha<0.05) return;

    var dx=b.sx-a.sx, dy=b.sy-a.sy;
    var dist=Math.sqrt(dx*dx+dy*dy);
    if(dist<2) return;

    /* dashed line */
    ctx.globalAlpha=alpha;
    ctx.strokeStyle='rgba(255,140,20,0.75)';
    ctx.lineWidth=0.8;
    ctx.setLineDash([5,7]);
    ctx.lineDashOffset=-time*8; /* animated march */
    ctx.beginPath();
    ctx.moveTo(a.sx,a.sy);
    ctx.lineTo(b.sx,b.sy);
    ctx.stroke();
    ctx.setLineDash([]);

    /* arrowhead at destination */
    var ux=dx/dist, uy=dy/dist;
    var base=slv('sl-sym')*Math.max(0.15,Math.min(1.0,(a.sc+b.sc)*2))*1.2;
    var ax2=b.sx-ux*base*1.4, ay2=b.sy-uy*base*1.4;
    var px=-uy*base*0.5, py=ux*base*0.5;
    ctx.globalAlpha=alpha*1.2;
    ctx.fillStyle='rgba(255,160,30,0.9)';
    ctx.beginPath();
    ctx.moveTo(b.sx,b.sy);
    ctx.lineTo(ax2+px,ay2+py);
    ctx.lineTo(ax2-px,ay2-py);
    ctx.closePath();
    ctx.fill();
  });
  ctx.restore();
}

function drawGrid(){
  ctx.save();
  var RINGS=[
    {r:0.2,lbl:'0.2'},{r:0.4,lbl:'0.4'},{r:0.6,lbl:'0.6'},
    {r:0.8,lbl:'0.8'},{r:1.0,lbl:'1.0 AU'},{r:1.3,lbl:'1.3'},{r:1.6,lbl:'1.6 AU'}
  ];
  RINGS.forEach(function(ring){
    ctx.beginPath();
    var first=true;
    for(var i=0;i<=160;i++){
      var a=(i/160)*Math.PI*2;
      var p=proj(Math.cos(a)*ring.r,0,Math.sin(a)*ring.r);
      if(!p)continue;
      if(first){ctx.moveTo(p.sx,p.sy);first=false;}
      else ctx.lineTo(p.sx,p.sy);
    }
    var al=0.07+ring.r*0.06;
    ctx.strokeStyle='rgba(210,85,0,'+al+')';
    ctx.lineWidth=ring.r>=1.0?1.0:0.7;ctx.stroke();

    var lp=proj(ring.r,0,0);
    if(lp&&lp.sx>0&&lp.sx<W&&lp.sy>0&&lp.sy<H){
      ctx.font="11px 'Share Tech Mono',monospace";
      ctx.fillStyle='rgba(200,80,0,0.6)';ctx.textAlign='left';
      ctx.fillText(ring.lbl,lp.sx+6,lp.sy-4);
    }
  });
  var c0=proj(0,0,0);
  if(c0){
    for(var k=0;k<16;k++){
      var ang2=k/16*Math.PI*2;
      var pe=proj(Math.cos(ang2)*1.6,0,Math.sin(ang2)*1.6);
      if(!pe)continue;
      ctx.beginPath();ctx.moveTo(c0.sx,c0.sy);ctx.lineTo(pe.sx,pe.sy);
      ctx.strokeStyle='rgba(160,55,0,0.1)';ctx.lineWidth=0.6;ctx.stroke();
    }
  }
  ctx.restore();
}

function drawAxes(){
  ctx.save();
  [{v:[1,0,0],c:'rgba(230,65,0,0.9)',l:'X'},
   {v:[0,0.6,0],c:'rgba(40,120,0,0.75)',l:'Y'},
   {v:[0,0,1],c:'rgba(0,75,220,0.75)',l:'Z'}
  ].forEach(function(ax){
    var p0=proj(0,0,0),p1=proj(ax.v[0],ax.v[1],ax.v[2]);
    if(!p0||!p1)return;
    ctx.beginPath();ctx.strokeStyle=ax.c;ctx.lineWidth=2;
    ctx.moveTo(p0.sx,p0.sy);ctx.lineTo(p1.sx,p1.sy);ctx.stroke();
    ctx.font="bold 13px 'Share Tech Mono',monospace";
    ctx.fillStyle=ax.c;ctx.fillText(ax.l,p1.sx+6,p1.sy+5);
  });
  ctx.restore();
}

function drawPlanet(){
  var p=proj(0,0,0);if(!p)return;
  var r=Math.max(12,Math.min(55,32*p.sc*W*0.55));
  var g1=ctx.createRadialGradient(p.sx,p.sy,r*0.5,p.sx,p.sy,r*6);
  g1.addColorStop(0,'rgba(210,90,15,0.4)');
  g1.addColorStop(0.3,'rgba(140,40,0,0.15)');
  g1.addColorStop(1,'rgba(0,0,0,0)');
  ctx.fillStyle=g1;ctx.beginPath();ctx.arc(p.sx,p.sy,r*6,0,Math.PI*2);ctx.fill();
  var g2=ctx.createRadialGradient(p.sx-r*0.28,p.sy-r*0.28,r*0.05,p.sx,p.sy,r);
  g2.addColorStop(0,'#f06020');g2.addColorStop(0.3,'#c83a10');
  g2.addColorStop(0.65,'#922000');g2.addColorStop(1,'#1c0300');
  ctx.fillStyle=g2;ctx.beginPath();ctx.arc(p.sx,p.sy,r,0,Math.PI*2);ctx.fill();
  ctx.save();ctx.globalAlpha=0.35;
  var rim=ctx.createRadialGradient(p.sx,p.sy,r*0.8,p.sx,p.sy,r);
  rim.addColorStop(0,'transparent');rim.addColorStop(1,'rgba(255,160,60,0.55)');
  ctx.fillStyle=rim;ctx.beginPath();ctx.arc(p.sx,p.sy,r,0,Math.PI*2);ctx.fill();ctx.restore();
  ctx.save();ctx.globalAlpha=0.4;
  ctx.strokeStyle='rgba(230,140,40,0.7)';ctx.lineWidth=1.8;
  ctx.beginPath();ctx.ellipse(p.sx,p.sy,r*2.6,r*0.5,0,0,Math.PI*2);ctx.stroke();ctx.restore();
  ctx.save();ctx.globalAlpha=0.55;ctx.strokeStyle='rgba(240,110,20,0.7)';ctx.lineWidth=1.2;
  var cr=r+8;
  [[cr,0,cr+12,0],[-cr,0,-cr-12,0],[0,-cr,0,-cr-12],[0,cr,0,cr+12]].forEach(function(l){
    ctx.beginPath();ctx.moveTo(p.sx+l[0],p.sy+l[1]);ctx.lineTo(p.sx+l[2],p.sy+l[3]);ctx.stroke();
  });
  ctx.restore();
  ctx.save();
  ctx.shadowColor='#ff5500';ctx.shadowBlur=15;ctx.textAlign='center';
  ctx.font="bold 13px 'Orbitron',monospace";ctx.fillStyle='#ffaa40';
  ctx.fillText('KALT.PRIM',p.sx,p.sy+r+20);
  ctx.font="11px 'Share Tech Mono',monospace";ctx.fillStyle='rgba(220,140,50,0.9)';
  ctx.fillText('0.0.0',p.sx,p.sy+r+35);
  ctx.shadowBlur=0;ctx.restore();ctx.textAlign='left';
}

function drawMark(m,p,ralpha){
  var col=CC[m.category];
  var base=slv('sl-sym');
  var sz=base*Math.max(0.12,Math.min(3.0,p.sc*W*0.28));
  var df=Math.max(0.12,Math.min(1.0,p.sc*8.0));
  var pulse=0.72+0.28*Math.sin(time*1.7+m.id*0.65);
  var finalAlpha=df*ralpha;

  /* appearing flash when just revealed */
  var flashAlpha=0;
  if(scanMode){
    var age=time-markRevealAt[MARKS.indexOf(m)];
    if(age>=0 && age<0.5){
      flashAlpha=(0.5-age)/0.5;
      ctx.save();
      ctx.globalAlpha=flashAlpha*0.6;
      var fg=ctx.createRadialGradient(p.sx,p.sy,0,p.sx,p.sy,sz*5);
      fg.addColorStop(0,col);fg.addColorStop(1,'transparent');
      ctx.fillStyle=fg;ctx.beginPath();ctx.arc(p.sx,p.sy,sz*5,0,Math.PI*2);ctx.fill();
      ctx.restore();
    }
  }

  /* glow halo */
  ctx.save();ctx.globalAlpha=0.13*finalAlpha*pulse;
  var gw=ctx.createRadialGradient(p.sx,p.sy,0,p.sx,p.sy,sz*2.6);
  gw.addColorStop(0,col);gw.addColorStop(1,'transparent');
  ctx.fillStyle=gw;ctx.beginPath();ctx.arc(p.sx,p.sy,sz*2.6,0,Math.PI*2);ctx.fill();
  ctx.restore();

  mkMarker(m.category,p.sx,p.sy,sz,col,finalAlpha*pulse);

  if(showLbl && sz>4){
    ctx.save();ctx.globalAlpha=Math.min(finalAlpha*0.9,0.9);
    var fsz=Math.max(9,sz*0.7);
    ctx.font=fsz+"px 'Share Tech Mono',monospace";
    ctx.textAlign='left';ctx.textBaseline='middle';
    ctx.shadowColor='#000000';ctx.shadowBlur=6;
    ctx.fillStyle='rgba(0,0,0,0.9)';ctx.fillText(m.coord,p.sx+sz+2,p.sy+1);
    ctx.fillStyle=col;ctx.fillText(m.coord,p.sx+sz+1,p.sy);
    ctx.shadowBlur=0;ctx.restore();
  }
}

function onMove(e){
  if(dragging){rotY+=(e.clientX-lastMX)*0.004;lastMX=e.clientX;hideTip();return;}
  var lr=document.getElementById('lp').getBoundingClientRect();
  var rr=document.getElementById('rp').getBoundingClientRect();
  if(e.clientX<=lr.right||e.clientX>=rr.left){hideTip();return;}

  var mx=e.clientX,my=e.clientY,found=null,minD=30;
  MARKS.forEach(function(m,i){
    if(hiddenCats[m.category])return;
    if(revealAlpha(i)<=0.01)return;
    var n=normPt(m),p=proj(n.x,n.y,n.z);if(!p)return;
    var d=Math.sqrt((p.sx-mx)*(p.sx-mx)+(p.sy-my)*(p.sy-my));
    if(d<minD){minD=d;found={m:m,p:p};}
  });
  if(found) showTip(found.m,e.clientX,e.clientY);
  else hideTip();
}

function showTip(m,mx,my){
  document.getElementById('t-coord').textContent='[ '+m.coord+' ]';
  var ce=document.getElementById('t-cat');
  ce.textContent=CN[m.category];
  ce.style.color=CC[m.category];ce.style.borderColor=CC[m.category];
  document.getElementById('t-sum').textContent=m.summary;
  document.getElementById('t-prev').textContent=m.context_preview+'...';
  var tip=document.getElementById('tip');
  tip.style.display='block';
  var tw=tip.offsetWidth||400, th=tip.offsetHeight||280;
  var tx=mx+22, ty=my-22;
  if(tx+tw>window.innerWidth-10) tx=mx-tw-22;
  if(ty+th>window.innerHeight-10) ty=window.innerHeight-th-10;
  if(ty<10) ty=10;
  tip.style.left=tx+'px';tip.style.top=ty+'px';
  document.getElementById('selid').textContent='#'+m.id;
}
function hideTip(){
  document.getElementById('tip').style.display='none';
  document.getElementById('selid').textContent='-';
}
function tog(cat,el){
  if(hiddenCats[cat]){delete hiddenCats[cat];el.classList.remove('off');}
  else{hiddenCats[cat]=true;el.classList.add('off');}
}

/* ── CHAIN LINES ── */
var showChains = true;
var chainPulse = 0;

function drawChains(){
  if(!showChains) return;
  chainPulse = 0.55 + 0.45*Math.sin(time*1.1);

  CHAINS.forEach(function(chain){
    if(chain._hidden) return;
    var ids = chain.marks; // 1-based IDs
    if(ids.length < 2) return;

    // collect projected points in order
    var pts = [];
    ids.forEach(function(mid){
      var m = MARKS[mid-1]; if(!m) return;
      if(hiddenCats[m.category]) return;
      var n = normPt(m);
      var p = proj(n.x, n.y, n.z);
      if(p) pts.push({p:p, mid:mid});
    });
    if(pts.length < 2) return;

    var col = chain.color;
    var rgb = hexToRgb(col);

    // Draw dashed lines with arrowheads between consecutive points
    for(var i=0; i<pts.length-1; i++){
      var a = pts[i].p, b = pts[i+1].p;

      // depth-based alpha — fade distant lines
      var df = Math.max(0.08, Math.min(0.55, (a.sc + b.sc)*3.5));
      var alpha = df * chainPulse;

      ctx.save();
      ctx.globalAlpha = alpha;
      ctx.strokeStyle = col;
      ctx.lineWidth = Math.max(0.6, Math.min(2.0, (a.sc+b.sc)*80));
      ctx.setLineDash([6, 8]);
      ctx.lineDashOffset = -time * 12; // animated dash flow

      ctx.beginPath();
      ctx.moveTo(a.sx, a.sy);
      ctx.lineTo(b.sx, b.sy);
      ctx.stroke();
      ctx.setLineDash([]);

      // Arrowhead at destination point b
      var dx = b.sx - a.sx, dy = b.sy - a.sy;
      var len = Math.sqrt(dx*dx + dy*dy);
      if(len > 12){
        var ux = dx/len, uy = dy/len;
        var arrowSz = Math.max(5, Math.min(14, (a.sc+b.sc)*100));
        // place arrow slightly before b so it doesn't overlap the marker
        var tip_x = b.sx - ux*arrowSz*0.4;
        var tip_y = b.sy - uy*arrowSz*0.4;
        ctx.beginPath();
        ctx.fillStyle = col;
        ctx.shadowColor = col; ctx.shadowBlur = arrowSz*0.5;
        ctx.moveTo(tip_x, tip_y);
        ctx.lineTo(tip_x - ux*arrowSz + uy*arrowSz*0.45,
                   tip_y - uy*arrowSz - ux*arrowSz*0.45);
        ctx.lineTo(tip_x - ux*arrowSz*0.6,
                   tip_y - uy*arrowSz*0.6);
        ctx.lineTo(tip_x - ux*arrowSz - uy*arrowSz*0.45,
                   tip_y - uy*arrowSz + ux*arrowSz*0.45);
        ctx.closePath();
        ctx.fill();
        ctx.shadowBlur = 0;
      }
      ctx.restore();
    }
  });
}


function toggleChain(idx, el){
  if(!CHAINS[idx]) return;
  CHAINS[idx]._hidden = !CHAINS[idx]._hidden;
  el.classList.toggle('off', CHAINS[idx]._hidden);
}

