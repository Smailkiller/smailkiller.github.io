<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>AUSPEX CARTOGRAPH :: KALT</title>
<style>
@import url('https://fonts.googleapis.com/css2?family=Share+Tech+Mono&family=Orbitron:wght@400;700;900&display=swap');
*{margin:0;padding:0;box-sizing:border-box;}
html,body{width:100%;height:100%;background:#000;overflow:hidden;}

#boot{position:fixed;inset:0;background:#000;z-index:1000;
  display:flex;flex-direction:column;padding:50px 80px;overflow:hidden;
  font-family:'Share Tech Mono',monospace;}
.b-gear{font-size:80px;color:#c0392b;text-shadow:0 0 50px #ff2200;
  animation:spin 8s linear infinite;display:block;text-align:center;margin-bottom:12px;}
.b-h1{font-family:'Orbitron',monospace;font-size:26px;font-weight:900;
  color:#e74c3c;letter-spacing:10px;text-shadow:0 0 18px #ff2200;text-align:center;}
.b-h2{font-size:13px;color:#6a3000;letter-spacing:6px;margin-top:6px;text-align:center;}
.b-hr{border:none;border-top:1px solid #c0392b;box-shadow:0 0 10px #ff2200;margin:18px 0;}
#b-con{flex:1;overflow:hidden;font-size:15px;line-height:2.0;color:#b85500;}
.cl{display:block;}
.ok{color:#806000;}.warn{color:#d4720a;}.sys{color:#c8a820;}.info{color:#885000;}.pr{color:#a07030;font-style:italic;}
#b-pw{margin-top:18px;border:1px solid #3a1a00;padding:3px;}
#b-p{height:10px;background:linear-gradient(90deg,#c0392b,#f08020);width:0%;transition:width .2s;box-shadow:0 0 12px #ff2200;}
#b-pl{text-align:right;font-size:12px;color:#6a3000;margin-top:5px;}

#app{display:none;position:fixed;inset:0;}
#cv{position:absolute;top:0;left:0;width:100%;height:100%;display:block;cursor:grab;}
#cv:active{cursor:grabbing;}
#app::after{content:'';position:fixed;inset:0;pointer-events:none;z-index:8000;
  background:repeating-linear-gradient(0deg,transparent,transparent 3px,rgba(0,0,0,0.04) 3px,rgba(0,0,0,0.04) 4px);}

#hud{position:absolute;top:0;left:0;right:0;height:64px;
  background:linear-gradient(180deg,rgba(20,5,0,0.97),rgba(6,2,0,0.90));
  border-bottom:2px solid #4a2000;
  display:flex;align-items:center;padding:0 24px;gap:0;z-index:500;pointer-events:none;
  font-family:'Share Tech Mono',monospace;}
.h-logo{font-family:'Orbitron',monospace;font-size:18px;font-weight:900;
  color:#e74c3c;letter-spacing:4px;text-shadow:0 0 14px #ff2200;}
.h-sep{width:2px;height:30px;background:#4a2000;margin:0 20px;flex-shrink:0;}
.h-st{font-size:12px;color:#8a4000;line-height:1.5;white-space:nowrap;}
.h-st b{color:#c8a820;font-weight:normal;font-size:14px;}
.h-spc{flex:1;}
#h-clk{font-family:'Orbitron',monospace;font-size:16px;color:#d4720a;letter-spacing:3px;}

#lp{position:absolute;top:64px;left:0;bottom:0;width:300px;
  background:rgba(3,1,0,0.92);border-right:2px solid #3a1a00;
  z-index:400;overflow-y:auto;padding:18px 16px;
  font-family:'Share Tech Mono',monospace;}
.pt{font-family:'Orbitron',monospace;font-size:10px;color:#c0392b;
  letter-spacing:3px;border-bottom:1px solid #3a1a00;padding-bottom:8px;margin-bottom:14px;
  text-shadow:0 0 8px #ff2200;}
.li{display:flex;align-items:center;gap:12px;padding:8px 4px;
  cursor:pointer;border-bottom:1px solid rgba(58,26,0,.25);
  transition:all .15s;user-select:none;pointer-events:all;}
.li:hover{background:rgba(200,57,0,.12);padding-left:10px;}
.li.off{opacity:.15;}
.l-sym-wrap{width:32px;height:32px;flex-shrink:0;display:flex;align-items:center;justify-content:center;}
.l-lbl{font-size:12px;letter-spacing:2px;flex:1;}
.l-n{font-size:11px;color:#6a3000;font-weight:bold;}
.cs{margin-top:18px;}
.cl2{font-size:10px;color:#5a2800;letter-spacing:2px;margin-bottom:5px;}
.sr{display:flex;align-items:center;gap:8px;margin-bottom:10px;}
input[type=range]{-webkit-appearance:none;flex:1;height:3px;background:#3a1a00;outline:none;}
input[type=range]::-webkit-slider-thumb{-webkit-appearance:none;width:14px;height:14px;
  background:#e74c3c;cursor:pointer;box-shadow:0 0 6px #ff2200;}
.sv{font-size:12px;color:#c8a820;width:36px;text-align:right;}
.br{display:flex;gap:6px;flex-wrap:wrap;margin-top:8px;}
.mb{background:rgba(192,57,43,.08);border:1px solid rgba(192,57,43,.5);
  color:#e74c3c;font-family:'Share Tech Mono',monospace;
  font-size:10px;letter-spacing:2px;padding:6px 12px;
  cursor:pointer;transition:all .15s;text-transform:uppercase;pointer-events:all;}
.mb:hover{background:rgba(192,57,43,.25);box-shadow:0 0 8px #ff2200;}
.mb.active{background:rgba(192,57,43,.35);box-shadow:0 0 12px #ff2200;color:#ffaa60;}
.sg{display:grid;grid-template-columns:1fr 1fr;gap:6px;margin-top:8px;}
.sb{border:1px solid #3a1a00;padding:8px;text-align:center;}
.sb .v{font-family:'Orbitron',monospace;font-size:18px;color:#c8a820;display:block;}
.sb .l{font-size:9px;color:#6a3000;letter-spacing:2px;margin-top:2px;}

#rp{position:absolute;top:64px;right:0;bottom:0;width:280px;
  background:rgba(3,1,0,0.92);border-left:2px solid #3a1a00;
  z-index:400;padding:18px 16px;display:flex;flex-direction:column;
  font-family:'Share Tech Mono',monospace;}
#feed{flex:1;overflow-y:auto;font-size:11px;line-height:1.7;}
.fe{border-bottom:1px solid rgba(58,26,0,.25);padding:6px 0;}
.fco{font-size:12px;display:flex;align-items:center;gap:6px;}
.fca{font-size:9px;letter-spacing:2px;margin-top:2px;}
.fst{color:#ffe8c0;font-size:10px;margin-top:2px;}

.cd{position:absolute;width:20px;height:20px;pointer-events:none;z-index:450;}
.cd.tl{top:69px;left:305px;border-top:2px solid #c0392b;border-left:2px solid #c0392b;}
.cd.tr{top:69px;right:285px;border-top:2px solid #c0392b;border-right:2px solid #c0392b;}
.cd.bl{bottom:5px;left:305px;border-bottom:2px solid #c0392b;border-left:2px solid #c0392b;}
.cd.br{bottom:5px;right:285px;border-bottom:2px solid #c0392b;border-right:2px solid #c0392b;}

/* ── TOOLTIP — large, fully opaque ── */
#tip{
  position:fixed;z-index:9500;display:none;
  width:400px;
  background:#050200;
  border:2px solid #e74c3c;
  box-shadow:0 0 0 1px rgba(231,76,60,0.35), 0 0 50px rgba(192,57,43,0.65),
             inset 0 0 30px rgba(0,0,0,0.9);
  padding:24px 26px;
  font-family:'Share Tech Mono',monospace;
  pointer-events:none;
}
.t-corner{position:absolute;width:14px;height:14px;}
.t-corner.tl{top:-2px;left:-2px;border-top:3px solid #e74c3c;border-left:3px solid #e74c3c;}
.t-corner.tr{top:-2px;right:-2px;border-top:3px solid #e74c3c;border-right:3px solid #e74c3c;}
.t-corner.bl{bottom:-2px;left:-2px;border-bottom:3px solid #e74c3c;border-left:3px solid #e74c3c;}
.t-corner.br{bottom:-2px;right:-2px;border-bottom:3px solid #e74c3c;border-right:3px solid #e74c3c;}
.t-label{font-size:11px;color:#7a3000;letter-spacing:4px;margin-bottom:8px;}
.t-coord{font-family:'Orbitron',monospace;font-size:22px;
  color:#ff8020;text-shadow:0 0 16px #ff6010;
  letter-spacing:3px;margin-bottom:12px;line-height:1.2;}
.t-cat-wrap{margin-bottom:16px;}
.t-cat{display:inline-block;font-size:14px;letter-spacing:4px;
  padding:7px 16px;border:2px solid currentColor;font-weight:bold;}
.t-divider{border:none;border-top:1px solid #3a1a00;margin:14px 0;}
.t-sum-label{font-size:11px;color:#7a3000;letter-spacing:3px;margin-bottom:7px;}
.t-sum{font-size:20px;color:#ffffff;line-height:1.5;font-weight:bold;}
.t-prev-label{font-size:11px;color:#7a3000;letter-spacing:3px;margin:14px 0 7px;}
.t-prev{font-size:14px;color:#b07040;line-height:1.65;font-style:italic;
  max-height:100px;overflow:hidden;}

::-webkit-scrollbar{width:4px;}::-webkit-scrollbar-thumb{background:#c0392b;}
@keyframes spin{from{transform:rotate(0deg);}to{transform:rotate(360deg);}}

.chain-legend { margin-top: 14px; }
.cl-item { display:flex; align-items:center; gap:7px; padding:3px 0;
  border-bottom:1px solid rgba(58,26,0,.15); font-size:9px; cursor:pointer;
  transition: opacity .15s; user-select:none; pointer-events:all; }
.cl-item:hover { opacity:.7; }
.cl-item.off { opacity:.2; }
.cl-line { flex-shrink:0; position:relative; }
.cl-lbl { color:#a06020; letter-spacing:1px; flex:1; line-height:1.3; }
.cl-n { color:#6a3000; font-size:8px; }

</style>
</head>
<body>

<div id="boot">
  <div class="b-gear">&#9881;</div>
  <div class="b-h1">ADEPTUS MECHANICUS</div>
  <div class="b-h2">AUSPEX CARTOGRAPH :: KALT :: VERIDIAN SYSTEM</div>
  <hr class="b-hr">
  <div id="b-con"></div>
  <div id="b-pw"><div id="b-p"></div></div>
  <div id="b-pl">INIT: 0%</div>
</div>

<div id="app">
  <canvas id="cv"></canvas>

  <div id="hud">
    <div class="h-logo">&#9881; AUSPEX CARTOGRAPH :: KALT</div>
    <div class="h-sep"></div>
    <div class="h-st">MARKS<br><b id="hud-total">0</b></div>
    <div class="h-sep"></div>
    <div class="h-st">VISIBLE<br><b id="vc">0</b></div>
    <div class="h-sep"></div>
    <div class="h-st">STATUS<br><b style="color:#907020">ACTIVE</b></div>
    <div class="h-sep"></div>
    <div class="h-st">PLANET<br><b>KALT.PRIM</b></div>
    <div class="h-spc"></div>
    <div id="h-clk">--:--:--</div>
  </div>

  <div id="lp">
    <div class="pt">:: CLASSIFICATION ::</div>

    <div class="li" onclick="tog('COMBAT',this)">
      <div class="l-sym-wrap">
        <svg width="28" height="28" viewBox="0 0 28 28">
          <line x1="4" y1="4" x2="24" y2="24" stroke="#e83010" stroke-width="2.5" stroke-linecap="round"/>
          <line x1="24" y1="4" x2="4" y2="24" stroke="#e83010" stroke-width="2.5" stroke-linecap="round"/>
          <rect x="11" y="2" width="6" height="9" rx="1" fill="none" stroke="#e83010" stroke-width="1.5"/>
          <rect x="11" y="17" width="6" height="9" rx="1" fill="none" stroke="#e83010" stroke-width="1.5"/>
          <circle cx="14" cy="14" r="3" fill="none" stroke="#e83010" stroke-width="1.5"/>
        </svg>
      </div>
      <span class="l-lbl" style="color:#e83010">&#1041;&#1054;&#1049;</span>
      <span class="l-n">12</span>
    </div>

    <div class="li" onclick="tog('FLEET',this)">
      <div class="l-sym-wrap">
        <svg width="28" height="28" viewBox="0 0 28 28">
          <polygon points="14,2 26,14 14,26 2,14" fill="none" stroke="#c08000" stroke-width="2"/>
          <polygon points="14,7 21,14 14,21 7,14" fill="rgba(192,128,0,0.15)" stroke="#c08000" stroke-width="1"/>
          <line x1="14" y1="2" x2="14" y2="26" stroke="#c08000" stroke-width="1" opacity="0.5"/>
          <line x1="2" y1="14" x2="26" y2="14" stroke="#c08000" stroke-width="1" opacity="0.5"/>
        </svg>
      </div>
      <span class="l-lbl" style="color:#c08000">&#1060;&#1051;&#1054;&#1058;</span>
      <span class="l-n">28</span>
    </div>

    <div class="li" onclick="tog('COMMAND',this)">
      <div class="l-sym-wrap">
        <svg width="28" height="28" viewBox="0 0 28 28">
          <polygon points="14,2 26,24 14,20 2,24" fill="rgba(224,160,0,0.1)" stroke="#e0a000" stroke-width="2"/>
          <line x1="14" y1="2" x2="14" y2="20" stroke="#e0a000" stroke-width="1.5"/>
          <line x1="6" y1="13" x2="14" y2="8" stroke="#e0a000" stroke-width="1.2"/>
          <line x1="22" y1="13" x2="14" y2="8" stroke="#e0a000" stroke-width="1.2"/>
        </svg>
      </div>
      <span class="l-lbl" style="color:#e0a000">&#1050;&#1054;&#1052;&#1040;&#1053;&#1044;&#1054;&#1042;&#1040;&#1053;&#1048;&#1045;</span>
      <span class="l-n">21</span>
    </div>

    <div class="li" onclick="tog('CHAOS',this)">
      <div class="l-sym-wrap">
        <svg width="28" height="28" viewBox="0 0 28 28">
          <g stroke="#c03800" stroke-width="2" stroke-linecap="round">
            <line x1="14" y1="2" x2="14" y2="26"/>
            <line x1="2" y1="14" x2="26" y2="14"/>
            <line x1="5" y1="5" x2="23" y2="23"/>
            <line x1="23" y1="5" x2="5" y2="23"/>
          </g>
          <circle cx="14" cy="14" r="4" fill="none" stroke="#c03800" stroke-width="1.5"/>
          <polygon points="14,2 12,7 16,7" fill="#c03800"/>
          <polygon points="26,14 21,12 21,16" fill="#c03800"/>
          <polygon points="14,26 12,21 16,21" fill="#c03800"/>
          <polygon points="2,14 7,12 7,16" fill="#c03800"/>
        </svg>
      </div>
      <span class="l-lbl" style="color:#c03800">&#1061;&#1040;&#1054;&#1057;</span>
      <span class="l-n">23</span>
    </div>

    <div class="li" onclick="tog('INFILTRATION',this)">
      <div class="l-sym-wrap">
        <svg width="28" height="28" viewBox="0 0 28 28">
          <ellipse cx="14" cy="14" rx="12" ry="7" fill="none" stroke="#a07800" stroke-width="2"/>
          <circle cx="14" cy="14" r="4" fill="rgba(160,120,0,0.2)" stroke="#a07800" stroke-width="1.5"/>
          <circle cx="14" cy="14" r="1.5" fill="#a07800"/>
          <line x1="2" y1="14" x2="5" y2="14" stroke="#a07800" stroke-width="1"/>
          <line x1="23" y1="14" x2="26" y2="14" stroke="#a07800" stroke-width="1"/>
        </svg>
      </div>
      <span class="l-lbl" style="color:#a07800">&#1048;&#1053;&#1060;&#1048;&#1051;&#1068;&#1058;&#1056;&#1040;&#1062;&#1048;&#1071;</span>
      <span class="l-n">48</span>
    </div>

    <div class="cs">
      <div class="pt">:: CONTROLS ::</div>
      <div class="cl2">CAMERA TILT</div>
      <div class="sr">
        <input type="range" id="sl-tilt" min="0.05" max="0.85" value="0.4" step="0.01">
        <div class="sv" id="sv-tilt">0.40</div>
      </div>
      <div class="cl2">ZOOM</div>
      <div class="sr">
        <input type="range" id="sl-zoom" min="0.05" max="20.0" value="1.2" step="0.1">
        <div class="sv" id="sv-zoom">1.20</div>
      </div>
      <div class="cl2">SYMBOL SIZE</div>
      <div class="sr">
        <input type="range" id="sl-sym" min="2" max="32" value="8" step="0.5">
        <div class="sv" id="sv-sym">8.0</div>
      </div>
      <div class="cl2">ROTATION SPEED</div>
      <div class="sr">
        <input type="range" id="sl-rot" min="0" max="5" value="0.8" step="0.1">
        <div class="sv" id="sv-rot">0.8</div>
      </div>
      <div class="br">
        <button class="mb" id="btn-reset">RESET</button>
        <button class="mb" id="btn-auto">AUTO</button>
        <button class="mb" id="btn-grid">GRID</button>
        <button class="mb" id="btn-lbl">LABELS</button>
        <button class="mb" id="btn-lnk">LINKS</button>
        <button class="mb" id="btn-chains">CHAINS</button>
        <button class="mb" id="btn-scan">SCAN</button>
      </div>
    </div>

    <div class="cs">
      <div class="pt">:: AUSPEX DATA ::</div>
      <div class="sg">
        <div class="sb"><span class="v" id="sb-total">0</span><div class="l">TOTAL</div></div>
        <div class="sb"><span class="v" id="vc2">0</span><div class="l">VISIBLE</div></div>
        <div class="sb"><span class="v">0.0.0</span><div class="l">CENTER</div></div>
        <div class="sb"><span class="v" id="selid">-</span><div class="l">SELECTED</div></div>
      </div>
    </div>
  </div>

  <div class="cd tl"></div><div class="cd tr"></div>
  <div class="cd bl"></div><div class="cd br"></div>

  <div id="rp">
    <div class="pt">:: EVENT LOG ::</div>
    <div id="feed"></div>
    <div class="chain-legend">
      <div class="pt" style="margin-top:14px;">:: CHAIN LINKS ::</div>
      <div class="cl-item" onclick="toggleChain(0,this)">
        <svg width="28" height="10" class="cl-line"><line x1="0" y1="5" x2="28" y2="5" stroke="#c08000" stroke-width="1.5" stroke-dasharray="4,3"/><polygon points="28,5 22,2 22,8" fill="#c08000"/></svg>
        <span class="cl-lbl">САМОФРАКИЯ / ЧУΡ</span>
        <span class="cl-n">8</span>
      </div>
      <div class="cl-item" onclick="toggleChain(1,this)">
        <svg width="28" height="10" class="cl-line"><line x1="0" y1="5" x2="28" y2="5" stroke="#e0a000" stroke-width="1.5" stroke-dasharray="4,3"/><polygon points="28,5 22,2 22,8" fill="#e0a000"/></svg>
        <span class="cl-lbl">ВЕНТАН (IV РОТА)</span>
        <span class="cl-n">21</span>
      </div>
      <div class="cl-item" onclick="toggleChain(2,this)">
        <svg width="28" height="10" class="cl-line"><line x1="0" y1="5" x2="28" y2="5" stroke="#e83010" stroke-width="1.5" stroke-dasharray="4,3"/><polygon points="28,5 22,2 22,8" fill="#e83010"/></svg>
        <span class="cl-lbl">ЖИЛЛИМАН / ГЕЙДЖ</span>
        <span class="cl-n">19</span>
      </div>
      <div class="cl-item" onclick="toggleChain(3,this)">
        <svg width="28" height="10" class="cl-line"><line x1="0" y1="5" x2="28" y2="5" stroke="#a07800" stroke-width="1.5" stroke-dasharray="4,3"/><polygon points="28,5 22,2 22,8" fill="#a07800"/></svg>
        <span class="cl-lbl">ОЛЛ ПЕРССОН</span>
        <span class="cl-n">9</span>
      </div>
      <div class="cl-item" onclick="toggleChain(4,this)">
        <svg width="28" height="10" class="cl-line"><line x1="0" y1="5" x2="28" y2="5" stroke="#d09000" stroke-width="1.5" stroke-dasharray="4,3"/><polygon points="28,5 22,2 22,8" fill="#d09000"/></svg>
        <span class="cl-lbl">ТИЕЛЬ (ОРБИТА)</span>
        <span class="cl-n">8</span>
      </div>
      <div class="cl-item" onclick="toggleChain(5,this)">
        <svg width="28" height="10" class="cl-line"><line x1="0" y1="5" x2="28" y2="5" stroke="#c03800" stroke-width="1.5" stroke-dasharray="4,3"/><polygon points="28,5 22,2 22,8" fill="#c03800"/></svg>
        <span class="cl-lbl">ЭРЕБ / ХАОС</span>
        <span class="cl-n">9</span>
      </div>
      <div class="cl-item" onclick="toggleChain(6,this)">
        <svg width="28" height="10" class="cl-line"><line x1="0" y1="5" x2="28" y2="5" stroke="#906000" stroke-width="1.5" stroke-dasharray="4,3"/><polygon points="28,5 22,2 22,8" fill="#906000"/></svg>
        <span class="cl-lbl">МАГОС ТАУРЕН</span>
        <span class="cl-n">5</span>
      </div>
      <div class="cl-item" onclick="toggleChain(7,this)">
        <svg width="28" height="10" class="cl-line"><line x1="0" y1="5" x2="28" y2="5" stroke="#b08000" stroke-width="1.5" stroke-dasharray="4,3"/><polygon points="28,5 22,2 22,8" fill="#b08000"/></svg>
        <span class="cl-lbl">БОЙ ЗА НУМИН</span>
        <span class="cl-n">9</span>
      </div>
      <div class="cl-item" onclick="toggleChain(8,this)">
        <svg width="28" height="10" class="cl-line"><line x1="0" y1="5" x2="28" y2="5" stroke="#887000" stroke-width="1.5" stroke-dasharray="4,3"/><polygon points="28,5 22,2 22,8" fill="#887000"/></svg>
        <span class="cl-lbl">ХЕЛЛОК / РЕЙН</span>
        <span class="cl-n">7</span>
      </div>
      <div class="cl-item" onclick="toggleChain(9,this)">
        <svg width="28" height="10" class="cl-line"><line x1="0" y1="5" x2="28" y2="5" stroke="#c08000" stroke-width="1.5" stroke-dasharray="4,3"/><polygon points="28,5 22,2 22,8" fill="#c08000"/></svg>
        <span class="cl-lbl">КАМПАНИЛА</span>
        <span class="cl-n">7</span>
      </div>
      <div class="cl-item" onclick="toggleChain(10,this)">
        <svg width="28" height="10" class="cl-line"><line x1="0" y1="5" x2="28" y2="5" stroke="#b03000" stroke-width="1.5" stroke-dasharray="4,3"/><polygon points="28,5 22,2 22,8" fill="#b03000"/></svg>
