function hexToRgb(hex){
  return parseInt(hex.slice(1,3),16)+','+parseInt(hex.slice(3,5),16)+','+parseInt(hex.slice(5,7),16);
}

function mkMarker(cat, cx, cy, sz, col, alpha){
  if(alpha<=0) return;
  ctx.save();
  ctx.globalAlpha = alpha;
  ctx.translate(cx, cy);
  ctx.scale(sz, sz);
  ctx.strokeStyle = col;
  ctx.fillStyle = col;
  ctx.lineCap = 'round';
  ctx.lineJoin = 'round';
  ctx.shadowColor = col;
  ctx.shadowBlur = sz * 0.55;

  switch(cat){
    case 'COMBAT':
      ctx.lineWidth=0.18;
      ctx.beginPath();ctx.moveTo(-0.7,-0.7);ctx.lineTo(0.7,0.7);ctx.stroke();
      ctx.beginPath();ctx.moveTo(0.7,-0.7);ctx.lineTo(-0.7,0.7);ctx.stroke();
      ctx.lineWidth=0.12;
      ctx.beginPath();ctx.moveTo(-0.35,-0.55);ctx.lineTo(0.35,-0.55);ctx.stroke();
      ctx.beginPath();ctx.moveTo(-0.35,0.55);ctx.lineTo(0.35,0.55);ctx.stroke();
      ctx.lineWidth=0.14;
      ctx.beginPath();ctx.arc(0,0,0.28,0,Math.PI*2);ctx.stroke();
      break;

    case 'FLEET':
      ctx.lineWidth=0.15;
      ctx.beginPath();ctx.moveTo(0,-0.85);ctx.lineTo(0.85,0);ctx.lineTo(0,0.85);ctx.lineTo(-0.85,0);ctx.closePath();ctx.stroke();
      ctx.lineWidth=0.09;
      ctx.beginPath();ctx.moveTo(0,-0.42);ctx.lineTo(0.42,0);ctx.lineTo(0,0.42);ctx.lineTo(-0.42,0);ctx.closePath();
      ctx.fillStyle='rgba('+hexToRgb(col)+',0.1)';ctx.fill();
      ctx.fillStyle=col;ctx.stroke();
      ctx.lineWidth=0.06;ctx.globalAlpha=alpha*0.35;
      ctx.beginPath();ctx.moveTo(0,-0.85);ctx.lineTo(0,0.85);ctx.stroke();
      ctx.beginPath();ctx.moveTo(-0.85,0);ctx.lineTo(0.85,0);ctx.stroke();
      ctx.globalAlpha=alpha;
      break;

    case 'COMMAND':
      ctx.lineWidth=0.15;
      ctx.beginPath();ctx.moveTo(0,-0.85);ctx.lineTo(0.85,0.85);ctx.lineTo(0,0.45);ctx.lineTo(-0.85,0.85);ctx.closePath();
      ctx.fillStyle='rgba('+hexToRgb(col)+',0.08)';ctx.fill();ctx.fillStyle=col;ctx.stroke();
      ctx.lineWidth=0.1;
      ctx.beginPath();ctx.moveTo(0,-0.85);ctx.lineTo(0,0.45);ctx.stroke();
      ctx.beginPath();ctx.moveTo(-0.5,0.1);ctx.lineTo(0,-0.3);ctx.lineTo(0.5,0.1);ctx.stroke();
      break;

    case 'CHAOS':
      ctx.lineWidth=0.14;
      var dirs=[[0,-1],[0.707,-0.707],[1,0],[0.707,0.707],[0,1],[-0.707,0.707],[-1,0],[-0.707,-0.707]];
      dirs.forEach(function(d){
        var ex=d[0]*0.85,ey=d[1]*0.85;
        ctx.beginPath();ctx.moveTo(0,0);ctx.lineTo(ex,ey);ctx.stroke();
        var perp=[-d[1]*0.15,d[0]*0.15];
        ctx.beginPath();
        ctx.moveTo(ex,ey);
        ctx.lineTo(ex-d[0]*0.22+perp[0],ey-d[1]*0.22+perp[1]);
        ctx.lineTo(ex-d[0]*0.22-perp[0],ey-d[1]*0.22-perp[1]);
        ctx.closePath();ctx.fill();
      });
      ctx.lineWidth=0.12;
      ctx.beginPath();ctx.arc(0,0,0.22,0,Math.PI*2);ctx.stroke();
      break;

    case 'INFILTRATION':
      ctx.lineWidth=0.13;
      ctx.beginPath();ctx.ellipse(0,0,0.85,0.48,0,0,Math.PI*2);ctx.stroke();
      ctx.beginPath();ctx.arc(0,0,0.32,0,Math.PI*2);
      ctx.fillStyle='rgba('+hexToRgb(col)+',0.1)';ctx.fill();ctx.fillStyle=col;ctx.stroke();
      ctx.lineWidth=0.09;
      ctx.beginPath();ctx.arc(0,0,0.14,0,Math.PI*2);ctx.stroke();
      ctx.beginPath();ctx.arc(0,0,0.05,0,Math.PI*2);ctx.fill();
      ctx.lineWidth=0.08;ctx.globalAlpha=alpha*0.45;
      [[-0.85,0],[0.85,0]].forEach(function(p){
        ctx.beginPath();ctx.moveTo(p[0]-0.1,p[1]);ctx.lineTo(p[0]+0.1,p[1]);ctx.stroke();
        ctx.beginPath();ctx.moveTo(p[0],p[1]-0.08);ctx.lineTo(p[0],p[1]+0.08);ctx.stroke();
      });
      ctx.globalAlpha=alpha;
      break;
  }
  ctx.restore();
}

